{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "booking-route": {
        "ClusterId": "reservas-cluster",
        "Match": { "Path": "/api/v1/naomy-analuisa/booking/{**remainder}" },
        "Transforms": [{ "PathPattern": "/api/v1/reservasanaluisa/{**remainder}" }]
      },
      "alojamientos-route": {
        "ClusterId": "alojamientos-cluster",
        "Match": { "Path": "/api/v1/naomy-analuisa/alojamientos/{**remainder}" },
        "Transforms": [{ "PathPattern": "/api/v1/alojamientosanaluisa/{**remainder}" }]
      },
      "habitaciones-route": {
        "ClusterId": "alojamientos-cluster",
        "Match": { "Path": "/api/v1/naomy-analuisa/habitaciones/{**remainder}" },
        "Transforms": [{ "PathPattern": "/api/v1/habitacionesanaluisa/{**remainder}" }]
      },
      "calendario-route": {
        "ClusterId": "alojamientos-cluster",
        "Match": { "Path": "/api/v1/naomy-analuisa/calendario/{**remainder}" },
        "Transforms": [{ "PathPattern": "/api/v1/calendarioanaluisa/{**remainder}" }]
      },
      "fotos-route": {
        "ClusterId": "alojamientos-cluster",
        "Match": { "Path": "/api/v1/naomy-analuisa/fotos/{**remainder}" },
        "Transforms": [{ "PathPattern": "/api/v1/fotosanaluisa/{**remainder}" }]
      },
      "auth-route": {
        "ClusterId": "usuarios-cluster",
        "Match": { "Path": "/api/v1/naomy-analuisa/auth/{**remainder}" },
        "Transforms": [{ "PathPattern": "/api/v1/authanaluisa/{**remainder}" }]
      },
      "clientes-route": {
        "ClusterId": "usuarios-cluster",
        "Match": { "Path": "/api/v1/naomy-analuisa/clientes/{**remainder}" },
        "Transforms": [{ "PathPattern": "/api/v1/clientesanaluisa/{**remainder}" }]
      },
      "facturas-route": {
        "ClusterId": "facturacion-cluster",
        "Match": { "Path": "/api/v1/naomy-analuisa/facturas/{**remainder}" },
        "Transforms": [{ "PathPattern": "/api/v1/facturasanaluisa/{**remainder}" }]
      },
      "metodospago-route": {
        "ClusterId": "facturacion-cluster",
        "Match": { "Path": "/api/v1/naomy-analuisa/metodospago/{**remainder}" },
        "Transforms": [{ "PathPattern": "/api/v1/metodospagoanaluisa/{**remainder}" }]
      }
    },
    "Clusters": {
      "alojamientos-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://alojamientosalojamientos.onrender.com/"
          }
        }
      },
      "reservas-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://alojamientosreservas.onrender.com/"
          }
        }
      },
      "usuarios-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://alojamientosusuarios.onrender.com/"
          }
        }
      },
      "facturacion-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://alojamientosfacturacion.onrender.com/"
          }
        }
      }
    }
  }
}
