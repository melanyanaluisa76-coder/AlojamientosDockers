    {
      "name": "🔐 1. Autenticación",
      "item": [
        {
          "name": "POST /auth/login — Login (directo MS)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('✅ Login exitoso (200)', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "const payload = body.data !== undefined ? body.data : body;",
            "if (payload?.token) {",
            "  pm.collectionVariables.set('token', payload.token);",
            "  pm.test('✅ Token JWT guardado', () => pm.expect(payload.token).to.be.a('string').and.to.have.length.above(10));",
            "} else { pm.test('⚠️ Token no encontrado', () => false); }"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@alojamiento.com\",\n  \"password\": \"Admin1234!\"\n}" },
            "url": { "raw": "{{clientes_url}}/api/v1/authanaluisa/login", "host": ["{{clientes_url}}"], "path": ["api","v1","authanaluisa","login"] }
          }
        },
        {
          "name": "POST /v2/auth/login — Login vía Gateway V2",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('✅ Login V2 vía Gateway (200)', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "const payload = body.data !== undefined ? body.data : body;",
            "if (payload?.token) { pm.collectionVariables.set('token', payload.token); pm.test('✅ Token guardado', () => true); }"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@alojamiento.com\",\n  \"password\": \"Admin1234!\"\n}" },
            "url": { "raw": "{{gateway_url}}/api/v2/naomy-analuisa/auth/login", "host": ["{{gateway_url}}"], "path": ["api","v2","naomy-analuisa","auth","login"] }
          }
        },
        {
          "name": "POST /clientes/registrar — Nuevo huésped",
