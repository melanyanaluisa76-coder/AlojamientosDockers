{
  "info": {
    "_postman_id": "alojamiento-mr-analuisa-suite",
    "name": "AlojamientoMR - Suite Completa de Pruebas (Analuisa)",
    "description": "Colección completa de pruebas para los 4 microservicios de AlojamientoMR. Variables pre-configuradas con las URLs reales de Render. Todos los endpoints usan el sufijo -analuisa. El flujo de variables es automático: ejecuta en orden y cada request guarda los IDs necesarios para la siguiente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "gateway_url",      "value": "https://alojamientosapigateway.onrender.com", "type": "string" },
    { "key": "clientes_url",     "value": "https://alojamientosusuarios.onrender.com",   "type": "string" },
    { "key": "alojamientos_url", "value": "https://alojamientosalojamientos.onrender.com", "type": "string" },
    { "key": "reservas_url",     "value": "https://alojamientosreservas.onrender.com",   "type": "string" },
    { "key": "facturacion_url",  "value": "https://alojamientosfacturacion.onrender.com","type": "string" },
    { "key": "token",            "value": "", "type": "string" },
    { "key": "clienteId",        "value": "", "type": "string" },
    { "key": "alojamientoId",    "value": "1", "type": "string" },
    { "key": "habitacionId",     "value": "1", "type": "string" },
    { "key": "reservaId",        "value": "", "type": "string" }
  ],
  "item": [

    {
      "name": "🔐 1. Autenticación (Usuarios MS)",
      "item": [

        {
          "name": "POST /authanaluisa/login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('✅ Login exitoso (200)', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const payload = body.data !== undefined ? body.data : body;",
                  "if (payload && payload.token) {",
                  "  pm.collectionVariables.set('token', payload.token);",
                  "  pm.test('✅ Token JWT guardado correctamente', () => pm.expect(payload.token).to.be.a('string').and.to.have.length.above(10));",
                  "} else {",
                  "  pm.test('⚠️ Token no encontrado en la respuesta', () => false);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@alojamiento.com\",\n  \"password\": \"Admin1234!\"\n}"
            },
            "url": {
              "raw": "{{clientes_url}}/api/v1/authanaluisa/login",
              "host": ["{{clientes_url}}"],
              "path": ["api", "v1", "authanaluisa", "login"]
            },
            "description": "Autenticación de usuario. El token JWT se guarda automáticamente en {{token}} para todas las demás requests. CAMBIA las credenciales por las de un usuario real en tu Supabase de Usuarios."
          }
        },

        {
          "name": "POST /clientesanaluisa/registrar — Nuevo huésped",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('✅ Cliente registrado (201)', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"huesped.prueba@email.com\",\n  \"password\": \"Huesped1234!\",\n  \"nombreCompleto\": \"María Prueba\",\n  \"cedula\": \"1799999999\",\n  \"telefono\": \"0991234567\",\n  \"domicilio\": \"Av. de la Prensa N54-140, Quito\"\n}"
            },
            "url": {
              "raw": "{{clientes_url}}/api/v1/clientesanaluisa/registrar",
              "host": ["{{clientes_url}}"],
              "path": ["api", "v1", "clientesanaluisa", "registrar"]
            },
            "description": "Registra un nuevo huésped. Cambia la cédula y email para evitar duplicados en cada prueba."
          }
        }

      ]
    },

