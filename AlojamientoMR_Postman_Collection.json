            "pm.test('✅ Cliente registrado (201)', () => pm.response.to.have.status(201));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"huesped.prueba@email.com\",\n  \"password\": \"Huesped1234!\",\n  \"nombreCompleto\": \"María Prueba\",\n  \"cedula\": \"1799999999\",\n  \"telefono\": \"0991234567\",\n  \"domicilio\": \"Av. de la Prensa N54-140, Quito\"\n}" },
            "url": { "raw": "{{clientes_url}}/api/v1/clientesanaluisa/registrar", "host": ["{{clientes_url}}"], "path": ["api","v1","clientesanaluisa","registrar"] }
          }
        }
      ]
