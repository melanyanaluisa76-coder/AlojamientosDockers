    {
      "name": "📋 4. Reservas V2 — con Idempotencia",
      "item": [
        {
          "name": "POST /v2/booking — Crear reserva (REQUIERE X-Idempotency-Key)",
          "event": [
            { "listen": "prerequest", "script": { "exec": [
              "const uuid = 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => {",
              "  const r = Math.random() * 16 | 0;",
              "  return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);",
              "});",
              "pm.collectionVariables.set('idempotencyKey', uuid);",
              "console.log('🔑 Idempotency-Key generado:', uuid);"
            ]}},
            { "listen": "test", "script": { "exec": [
              "pm.test('✅ Reserva creada (201) o idempotente (200)', () => pm.expect([200,201]).to.include(pm.response.code));",
              "const body = pm.response.json();",
              "const reserva = body.data !== undefined ? body.data : body;",
              "if (reserva?.reservaId) {",
              "  pm.collectionVariables.set('reservaId', String(reserva.reservaId));",
              "  pm.test('✅ reservaId guardado: ' + reserva.reservaId, () => true);",
              "  pm.test('✅ Tiene codigoReserva', () => pm.expect(reserva).to.have.property('codigoReserva'));",
              "  pm.test('✅ Estado inicial Pendiente', () => pm.expect(reserva.estado).to.equal('Pendiente'));",
              "}"
            ]}}
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization",    "value": "Bearer {{token}}" },
              { "key": "Content-Type",     "value": "application/json" },
              { "key": "X-Idempotency-Key","value": "{{idempotencyKey}}", "description": "UUID único por transacción — se auto-genera en Pre-request Script" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"clienteId\": {{clienteId}},\n  \"alojamientoId\": {{alojamientoId}},\n  \"fechaCheckIn\": \"2026-08-10\",\n  \"fechaCheckOut\": \"2026-08-15\",\n  \"numAdultos\": 2,\n  \"numNinos\": 0,\n  \"llevaMascotas\": false,\n  \"codigoDescuento\": null,\n  \"habitaciones\": [\n    {\n      \"habitacionId\": {{habitacionId}},\n      \"precioPorNoche\": 75.00,\n      \"numNoches\": 5\n    }\n  ]\n}" },
            "url": { "raw": "{{gateway_url}}/api/v2/naomy-analuisa/booking", "host": ["{{gateway_url}}"], "path": ["api","v2","naomy-analuisa","booking"] },
            "description": "IMPORTANTE: X-Idempotency-Key se genera automáticamente en Pre-request Script como UUID v4.\n\nComportamiento:\n- 201: Primera vez con esa clave → reserva creada\n- 200: Reintento con misma clave → respuesta cacheada\n- 409: Dos peticiones concurrentes con la misma clave\n- 400: Cabecera ausente o UUID inválido\n\nTras crear la reserva, RabbitMQ dispara automáticamente la creación de la factura draft en Facturacion.API."
          }
        },
        {
          "name": "POST /v2/booking — Reintento idempotente (misma clave = 200)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('✅ Reintento idempotente devuelve 200', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "const reserva = body.data !== undefined ? body.data : body;",
            "pm.test('✅ Misma reserva cacheada (mismo reservaId)', () => pm.expect(String(reserva.reservaId)).to.equal(pm.collectionVariables.get('reservaId')));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization",    "value": "Bearer {{token}}" },
              { "key": "Content-Type",     "value": "application/json" },
              { "key": "X-Idempotency-Key","value": "{{idempotencyKey}}", "description": "MISMA clave del request anterior para probar idempotencia" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"clienteId\": {{clienteId}},\n  \"alojamientoId\": {{alojamientoId}},\n  \"fechaCheckIn\": \"2026-08-10\",\n  \"fechaCheckOut\": \"2026-08-15\",\n  \"numAdultos\": 2,\n  \"numNinos\": 0,\n  \"llevaMascotas\": false,\n  \"codigoDescuento\": null,\n  \"habitaciones\": [\n    {\n      \"habitacionId\": {{habitacionId}},\n      \"precioPorNoche\": 75.00,\n      \"numNoches\": 5\n    }\n  ]\n}" },
            "url": { "raw": "{{gateway_url}}/api/v2/naomy-analuisa/booking", "host": ["{{gateway_url}}"], "path": ["api","v2","naomy-analuisa","booking"] },
            "description": "Envía exactamente la misma X-Idempotency-Key que el request anterior. Debe devolver 200 con la respuesta cacheada (NO crea duplicado)."
          }
        },
        {
          "name": "POST /v2/booking — Sin clave (400 esperado)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('✅ Sin X-Idempotency-Key devuelve 400', () => pm.response.to.have.status(400));",
            "const body = pm.response.json();",
            "pm.test('✅ Mensaje de error presente', () => pm.expect(body.message || body.Message).to.include('Idempotency'));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"clienteId\": {{clienteId}},\n  \"alojamientoId\": {{alojamientoId}},\n  \"fechaCheckIn\": \"2026-09-01\",\n  \"fechaCheckOut\": \"2026-09-05\",\n  \"numAdultos\": 1,\n  \"numNinos\": 0,\n  \"llevaMascotas\": false,\n  \"habitaciones\": [{ \"habitacionId\": {{habitacionId}}, \"precioPorNoche\": 75.00, \"numNoches\": 4 }]\n}" },
            "url": { "raw": "{{gateway_url}}/api/v2/naomy-analuisa/booking", "host": ["{{gateway_url}}"], "path": ["api","v2","naomy-analuisa","booking"] },
            "description": "Prueba negativa: sin cabecera X-Idempotency-Key. El servidor debe rechazar con 400."
          }
        },
        {
          "name": "GET /v2/booking/:id — Consultar reserva",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('✅ Status 200', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "const r = body.data !== undefined ? body.data : body;",
            "pm.test('✅ Tiene codigoReserva', () => pm.expect(r).to.have.property('codigoReserva'));",
            "pm.test('✅ Tiene estado', () => pm.expect(r).to.have.property('estado'));"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{gateway_url}}/api/v2/naomy-analuisa/booking/{{reservaId}}", "host": ["{{gateway_url}}"], "path": ["api","v2","naomy-analuisa","booking","{{reservaId}}"] }
          }
        },
        {
          "name": "GET /v2/booking/cliente/:id — Reservas del cliente",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('✅ Status 200', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "const list = body.data !== undefined ? body.data : body;",
            "pm.test('✅ Es un array', () => pm.expect(list).to.be.an('array'));"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{gateway_url}}/api/v2/naomy-analuisa/booking/cliente/{{clienteId}}", "host": ["{{gateway_url}}"], "path": ["api","v2","naomy-analuisa","booking","cliente","{{clienteId}}"] }
          }
        },
        {
          "name": "PATCH /v2/booking/:id/estado — Cancelar reserva",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('✅ Estado actualizado (204)', () => pm.response.to.have.status(204));"
          ]}}],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"estado\": \"Cancelada\"\n}" },
            "url": { "raw": "{{gateway_url}}/api/v2/naomy-analuisa/booking/{{reservaId}}/estado", "host": ["{{gateway_url}}"], "path": ["api","v2","naomy-analuisa","booking","{{reservaId}}","estado"] }
          }
        }
      ]
    },

    {
      "name": "💳 5. Facturación V2",
      "item": [
        {
          "name": "GET /v2/metodospago — Métodos disponibles",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('✅ Status 200', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "const list = body.data !== undefined ? body.data : body;",
            "pm.test('✅ Al menos un método', () => pm.expect(list.length).to.be.above(0));"
          ]}}],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{gateway_url}}/api/v2/naomy-analuisa/metodospago", "host": ["{{gateway_url}}"], "path": ["api","v2","naomy-analuisa","metodospago"] }
          }
        },
        {
          "name": "GET /v2/facturas/reserva/:id — Factura auto-generada por RabbitMQ",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('✅ Status 200 (factura auto-creada por RabbitMQ)', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "const facturas = body.data !== undefined ? body.data : body;",
            "const factura = Array.isArray(facturas) ? facturas[0] : facturas;",
            "if (factura?.facturaId) {",
            "  pm.collectionVariables.set('facturaId', String(factura.facturaId));",
            "  pm.test('✅ facturaId guardado: ' + factura.facturaId, () => true);",
            "  pm.test('✅ Estado es Pendiente (draft)', () => pm.expect(factura.estado).to.equal('Pendiente'));",
            "}"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{gateway_url}}/api/v2/naomy-analuisa/facturas/reserva/{{reservaId}}", "host": ["{{gateway_url}}"], "path": ["api","v2","naomy-analuisa","facturas","reserva","{{reservaId}}"] },
            "description": "La factura draft se crea AUTOMÁTICAMENTE cuando se hace el POST /booking mediante RabbitMQ (ReservaCreadaEvent → ReservaCreadaConsumer en Facturacion.API). No es necesario llamar a POST /facturas manualmente."
          }
        },
