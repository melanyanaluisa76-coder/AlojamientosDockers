    {
      "name": "🔐 1. Autenticación",
      "item": [
        {
          "name": "POST /auth/login — Admin (guarda token)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('✅ Status 200', () => pm.response.to.have.status(200));",
            "const b = pm.response.json();",
            "pm.test('✅ Responde con token', () => pm.expect(b).to.have.property('token'));",
            "if (b.token) pm.collectionVariables.set('token', b.token);",
            "pm.test('✅ Token guardado', () => pm.expect(pm.collectionVariables.get('token')).to.be.a('string').and.not.empty);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@alojamiento.com\",\n  \"password\": \"Admin12345!\"\n}" },
            "url": { "raw": "{{gateway}}{{prefix}}/auth/login", "host": ["{{gateway}}"], "path": ["api","v1","naomy-analuisa","auth","login"] }
          }
        },
        {
          "name": "POST /auth/login — Credenciales incorrectas (debe dar 401)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('✅ Rechaza credenciales inválidas (401)', () => pm.response.to.have.status(401));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"noexiste@nada.com\",\n  \"password\": \"WrongPass999\"\n}" },
            "url": { "raw": "{{gateway}}{{prefix}}/auth/login", "host": ["{{gateway}}"], "path": ["api","v1","naomy-analuisa","auth","login"] }
          }
